# ==============================================================================
# Holhuashi VPS Production Configuration (.env)
# ==============================================================================

# Server Domain for Caddy (Let's Encrypt TLS will be generated automatically)
DOMAIN=api.holhuashi.mv

# Node Server Environment
NODE_ENV=production
PORT=8080
CORS_ORIGIN=*

# PostgreSQL Configuration
POSTGRES_USER=holhuashi_admin
POSTGRES_PASSWORD=generate_a_secure_random_password_here
POSTGRES_DB=thaasbai_digu

# Database connection used by Node server inside Docker network
DATABASE_URL=postgres://holhuashi_admin:generate_a_secure_random_password_here@postgres:5432/thaasbai_digu
DATABASE_SSL=false

# Redis Configuration
REDIS_URL=redis://redis:6379

# Cloudflare R2 Off-site Database Backup Credentials
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=holhuashi-backups
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
