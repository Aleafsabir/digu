# fastlane/Screengrabfile
# Android Automated Screengrab Configuration for Google Play Store

app_package_name("com.thaasbai.digu")
use_tests_in_classes(["com.thaasbai.digu.ScreenshotTest"])

# APK Paths generated by Gradle
app_apk_path("../android/app/build/outputs/apk/debug/app-debug.apk")
tests_apk_path("../android/app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk")

locales(["en-US"])

# Target orientations (Holhuashi is a landscape-first mobile game)
clear_previous_screenshots(true)

# Output directory mapped directly to Google Play Fastlane metadata
output_directory("./fastlane/metadata/android/images/phoneScreenshots")
